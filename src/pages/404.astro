---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Страница не найдена — СК Голдстрой" description="Запрашиваемая страница не существует.">
<section class="section-cta-full" style="min-height: 80vh;">
  <div class="cta-bg" style="background-image:url('https://images.unsplash.com/photo-1541888081622-1f48ed24dc1c?w=1920&q=80')"></div>
  <div class="cta-overlay" style="background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(10,10,10,0.95));"></div>
  <div class="container cta-inner" style="max-width: 800px;">
    <div class="eyebrow eyebrow-gold" data-aos="fade-up">Ошибка 404</div>
    <h1 class="h1-page" style="font-size: clamp(80px, 15vw, 150px); color: #c9a063; margin-bottom: 0; line-height: 1;" data-aos="fade-up" data-aos-delay="100">404</h1>
    <h2 class="h2 h2-white" style="margin-top: 20px; margin-bottom: 20px;" data-aos="fade-up" data-aos-delay="200">Страница не найдена</h2>
    <p class="body-text" style="margin: 0 auto 40px; color: rgba(255,255,255,0.7); max-width: 500px;" data-aos="fade-up" data-aos-delay="300">
      Возможно, она была удалена, перемещена по другому адресу или вы просто опечатались в ссылке.
    </p>
    <div class="cta-btns" data-aos="fade-up" data-aos-delay="400">
      <a href="/" class="btn btn-gold">Вернуться на главную</a>
    </div>
  </div>
</section>
</Layout>
